/* File properties (Details tab) for dinput8.dll. */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MOD_VER
 PRODUCTVERSION MOD_VER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", MOD_NAME
            VALUE "ProductVersion", MOD_VER_STR
            VALUE "FileDescription", MOD_NAME " - fixes and options for " MOD_GAME
            VALUE "FileVersion", MOD_VER_STR
            VALUE "LegalCopyright", "(c) " MOD_YEAR " " MOD_NAME ". Free to use, see README."
            VALUE "Comments", MOD_NOTICE
            VALUE "InternalName", "dinput8.dll"
            VALUE "OriginalFilename", "dinput8.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
